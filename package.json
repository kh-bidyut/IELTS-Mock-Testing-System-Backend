{
  "name": "ielts-mock-testing-server",
  "version": "1.0.0",
  "description": "Professional Backend Server for IELTS Mock Testing System",
  "main": "server.js",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "debug": "node --inspect server.js",
    "seed": "node seed.js",
    "migrate": "node migrate-structure.js",
    "clean": "node -e \"require('fs').rmSync('uploads', { recursive: true, force: true }); console.log('Uploads directory cleaned')\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "prettier": "prettier --write \"**/*.js\"",
    "prettier:check": "prettier --check \"**/*.js\"",
    "build": "echo \"No build required for Node.js application\"",
    "health": "curl -s http://localhost:5000/api/health | jq"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  },
  "keywords": [
    "ielts",
    "mock-test",
    "education",
    "language-assessment",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "IELTS Mock Testing Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ielts-mock-testing.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ielts-mock-testing/issues"
  },
  "homepage": "https://github.com/your-username/ielts-mock-testing#readme"
}
